@page "/"
@rendermode InteractiveServer
@inject IStockReportRepository StockReportRepository
@inject IStringLocalizer<SharedResources> L
@inject IStringLocalizer<StockReportResources> FieldText

<PageTitle>@L["AppName"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@L["AppName"]</h1>
        <p class="text-muted mb-0">
            @L["HomeIntro"]
        </p>
    </div>
    <a class="btn btn-primary" href="/stock-import">
        @L["HomeImportButton"]
    </a>
</div>

@if (_currentBatch is null)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h2 class="h5 mb-2">@L["HomeNoReportTitle"]</h2>
            <p class="text-muted mb-3">
                @L["HomeNoReportText"]
            </p>
            <a class="btn btn-outline-primary" href="/stock-import">@L["GoToStockImport"]</a>
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-semibold">@L["HomeSourceFile"]</div>
                    <div class="fs-5 fw-bold text-truncate" title="@_currentBatch.SourceFileName">@_currentBatch.SourceFileName</div>
                    <div class="small text-muted">@L["HomeSheet", _currentBatch.SheetName]</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-semibold">@L["HomeImportedRows"]</div>
                    <div class="fs-4 fw-bold">@_currentBatch.TotalRows</div>
                    <div class="small text-muted">@L["UtcTimestamp", _currentBatch.ImportedAtUtc]</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-semibold">@L["HomeTotalQuantity"]</div>
                    <div class="fs-4 fw-bold text-primary">@_currentBatch.TotalQuantity.ToString("N3")</div>
                    <div class="small text-muted">@L["HomeAcrossValidRows"]</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-semibold">@L["HomeTotalValue"]</div>
                    <div class="fs-4 fw-bold text-success">@_currentBatch.TotalValue.ToString("N2")</div>
                    <div class="small text-muted">@L["HomeMonetaryValue"]</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h2 class="h6 mb-0">@L["HomeFieldsTitle"]</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@L["HomeFieldKey"]</th>
                    <th>@L["HomeFieldName"]</th>
                    <th>@L["HomeFieldType"]</th>
                    <th>@L["HomeFieldDescription"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (StockReportFieldMetadata field in StockReportFieldCatalog.All)
                {
                    <tr>
                        <td><code>@field.Key</code></td>
                        <td>@field.GetLocalizedName()</td>
                        <td><span class="badge bg-secondary">@field.DataType</span></td>
                        <td class="text-muted">@field.GetLocalizedDescription(FieldText)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private StockReportBatch? _currentBatch;

    protected override async Task OnInitializedAsync()
    {
        _currentBatch = await StockReportRepository.GetCurrentAsync();
    }
}
