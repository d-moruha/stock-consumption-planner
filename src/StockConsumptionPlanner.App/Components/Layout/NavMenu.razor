@inject IStringLocalizer<SharedResources> L

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@L["AppName"]</a>
    </div>
</div>

<input type="checkbox" title="@L["NavigationMenu"]" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @L["NavOverview"]
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="stock-import">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @L["NavStockImport"]
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="consumption-plans">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> @L["NavConsumptionPlans"]
            </NavLink>
        </div>
    </nav>
</div>
