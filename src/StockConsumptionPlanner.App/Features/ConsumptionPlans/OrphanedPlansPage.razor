@page "/consumption-plans/orphaned"
@rendermode InteractiveServer
@inject GetPlansHandler PlansHandler
@inject DeletePlanHandler DeleteHandler
@inject PlanEditPolicy EditPolicy
@inject ConsumptionPlanOptions PlanOptions
@inject IStringLocalizer<ConsumptionPlansResources> L

<PageTitle>@L["OrphanedTitle"]</PageTitle>

<div class="screen-row">
<div class="screen-row-chrome">
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">@L["OrphanedTitle"]</h1>
        <p class="text-muted mb-0">
            @L["OrphanedIntro", PlanOptions.OrphanRetentionMonths]
        </p>
    </div>
    <a class="btn btn-outline-secondary" href="/consumption-plans">@L["BackToPlans"]</a>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert @(_isErrorStatus ? "alert-danger" : "alert-success") d-flex justify-content-between align-items-center" role="alert">
        <span>@_statusMessage</span>
        <button type="button" class="btn-close" @onclick="() => _statusMessage = null" aria-label="@L["Close"]"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label fw-semibold" for="orphanSearchInput">@L["Search"]</label>
                <input id="orphanSearchInput"
                       type="search"
                       class="form-control"
                       placeholder="@L["SearchPlaceholder"]"
                       @bind="_search" />
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-primary w-100" disabled="@_isBusy" @onclick="SearchAsync">@L["Search"]</button>
            </div>
        </div>
    </div>
</div>

@if (_plans is null)
{
    <p class="text-muted">@L["Loading"]</p>
}
else if (_plans.TotalCount == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 text-muted">@L["NoOrphanedPlans"]</div>
    </div>
}
</div>
@if (_plans is not null && _plans.TotalCount > 0)
{
    <div class="card border-0 shadow-sm scroll-table-card">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@L["ColumnDocument"]</th>
                        <th>@L["ColumnItem"]</th>
                        <th>@L["ColumnYear"]</th>
                        <th>@L["ColumnMaterial"]</th>
                        <th>@L["ColumnDescription"]</th>
                        <th>@L["TargetMonth"]</th>
                        <th class="text-end">@L["ColumnPlanned"]</th>
                        <th>@L["ColumnOrphanedSince"]</th>
                        <th>@L["ColumnDeletedAfter"]</th>
                        <th class="text-end">@L["ColumnActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ConsumptionPlanDto plan in _plans.Items)
                    {
                        <tr @key="plan.Id">
                            <td><code>@plan.MaterialDocumentNumber</code></td>
                            <td><code>@plan.MaterialDocumentItem</code></td>
                            <td>@plan.MaterialDocumentYear</td>
                            <td>@plan.MaterialNumber</td>
                            <td class="text-truncate" style="max-width: 18rem;" title="@plan.MaterialDescription">@plan.MaterialDescription</td>
                            <td>@ConsumptionPlanDisplay.FormatMonth(plan.TargetYear, plan.TargetMonth)</td>
                            <td class="text-end">@ConsumptionPlanDisplay.FormatQuantity(plan.PlannedQuantity)</td>
                            <td class="small">@FormatLocal(plan.OrphanedAtUtc)</td>
                            <td class="small">@FormatLocal(plan.PurgeDueAtUtc)</td>
                            <td class="text-end">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        disabled="@(!plan.CanDelete || _isBusy)"
                                        title="@(plan.CanDelete ? L["DeletePlanTooltip"] : L["EditPeriodEndedTooltip"])"
                                        @onclick="() => DeleteAsync(plan)">
                                    @L["Delete"]
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <span class="small text-muted">@L["OrphanedFooter", _plans.TotalCount, EditPolicy.TimeZone.Id]</span>
            <div>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1 || _isBusy)" @onclick="() => GoToPageAsync(_page - 1)">@L["Previous"]</button>
                <button type="button" class="btn btn-sm btn-outline-secondary ms-1" disabled="@(_page * _plans.PageSize >= _plans.TotalCount || _isBusy)" @onclick="() => GoToPageAsync(_page + 1)">@L["Next"]</button>
            </div>
        </div>
    </div>
}
</div>

@code {
    private PagedResult<ConsumptionPlanDto>? _plans;
    private string? _search;
    private int _page = 1;
    private bool _isBusy;
    private string? _statusMessage;
    private bool _isErrorStatus;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isBusy = true;
        try
        {
            _plans = await PlansHandler.ListAsync(new GetPlansQuery(Status: PlanLinkFilter.Orphaned, Search: _search, Page: _page));
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = Math.Max(1, page);
        await LoadAsync();
    }

    private async Task DeleteAsync(ConsumptionPlanDto plan)
    {
        _isBusy = true;
        try
        {
            ConsumptionPlanResult<bool> result = await DeleteHandler.HandleAsync(plan.Id, plan.Version);
            _isErrorStatus = !result.IsSuccess;
            StockDocumentKey key = new(plan.MaterialDocumentYear, plan.MaterialDocumentNumber, plan.MaterialDocumentItem);
            _statusMessage = result.IsSuccess
                ? L["PlanDeleted", key.ToString()]
                : ConsumptionPlanDisplay.LocalizeError(
                    L,
                    result.Error!,
                    key,
                    new PlanTargetMonth(plan.TargetYear, plan.TargetMonth));
            await LoadAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private string FormatLocal(DateTimeOffset? utc) => ConsumptionPlanDisplay.FormatBusinessTime(EditPolicy, utc);
}
