@page "/consumption-plans/orphaned"
@rendermode InteractiveServer
@using System.Globalization
@inject GetPlansHandler PlansHandler
@inject DeletePlanHandler DeleteHandler
@inject PlanEditPolicy EditPolicy
@inject ConsumptionPlanOptions PlanOptions

<PageTitle>Orphaned Consumption Plans</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Orphaned Consumption Plans</h1>
        <p class="text-muted mb-0">
            Plans whose stock record is missing from the current stock report. They are read-only, re-link automatically
            when the record returns in a later import, and are deleted after @PlanOptions.OrphanRetentionMonths months.
        </p>
    </div>
    <a class="btn btn-outline-secondary" href="/consumption-plans">Back to Plans</a>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert @(_isErrorStatus ? "alert-danger" : "alert-success") d-flex justify-content-between align-items-center" role="alert">
        <span>@_statusMessage</span>
        <button type="button" class="btn-close" @onclick="() => _statusMessage = null" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label fw-semibold" for="orphanSearchInput">Search</label>
                <input id="orphanSearchInput"
                       type="search"
                       class="form-control"
                       placeholder="Material number, description, or document number"
                       @bind="_search" />
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-primary w-100" disabled="@_isBusy" @onclick="SearchAsync">Search</button>
            </div>
        </div>
    </div>
</div>

@if (_plans is null)
{
    <p class="text-muted">Loading…</p>
}
else if (_plans.TotalCount == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 text-muted">No orphaned plans.</div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Document</th>
                        <th>Item</th>
                        <th>Year</th>
                        <th>Material</th>
                        <th>Description</th>
                        <th>Target Month</th>
                        <th class="text-end">Planned</th>
                        <th>Orphaned Since</th>
                        <th>Deleted After</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ConsumptionPlanDto plan in _plans.Items)
                    {
                        <tr @key="plan.Id">
                            <td><code>@plan.MaterialDocumentNumber</code></td>
                            <td><code>@plan.MaterialDocumentItem</code></td>
                            <td>@plan.MaterialDocumentYear</td>
                            <td>@plan.MaterialNumber</td>
                            <td class="text-truncate" style="max-width: 18rem;" title="@plan.MaterialDescription">@plan.MaterialDescription</td>
                            <td>@($"{plan.TargetYear:D4}-{plan.TargetMonth:D2}")</td>
                            <td class="text-end">@plan.PlannedQuantity.ToString("#,0.####", CultureInfo.InvariantCulture)</td>
                            <td class="small">@FormatLocal(plan.OrphanedAtUtc)</td>
                            <td class="small">@FormatLocal(plan.PurgeDueAtUtc)</td>
                            <td class="text-end">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        disabled="@(!plan.CanDelete || _isBusy)"
                                        title="@(plan.CanDelete ? "Delete this plan" : "The edit period for this plan has ended")"
                                        @onclick="() => DeleteAsync(plan)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <span class="small text-muted">@_plans.TotalCount orphaned plan(s). Times are in @EditPolicy.TimeZone.Id.</span>
            <div>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1 || _isBusy)" @onclick="() => GoToPageAsync(_page - 1)">Previous</button>
                <button type="button" class="btn btn-sm btn-outline-secondary ms-1" disabled="@(_page * _plans.PageSize >= _plans.TotalCount || _isBusy)" @onclick="() => GoToPageAsync(_page + 1)">Next</button>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<ConsumptionPlanDto>? _plans;
    private string? _search;
    private int _page = 1;
    private bool _isBusy;
    private string? _statusMessage;
    private bool _isErrorStatus;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isBusy = true;
        try
        {
            _plans = await PlansHandler.ListAsync(new GetPlansQuery(Status: PlanLinkFilter.Orphaned, Search: _search, Page: _page));
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = Math.Max(1, page);
        await LoadAsync();
    }

    private async Task DeleteAsync(ConsumptionPlanDto plan)
    {
        _isBusy = true;
        try
        {
            ConsumptionPlanResult<bool> result = await DeleteHandler.HandleAsync(plan.Id, plan.Version);
            _isErrorStatus = !result.IsSuccess;
            _statusMessage = result.IsSuccess
                ? $"Plan for {plan.MaterialDocumentYear}/{plan.MaterialDocumentNumber}/{plan.MaterialDocumentItem} deleted."
                : result.Error!.Message;
            await LoadAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private string FormatLocal(DateTimeOffset? utc) =>
        utc is null ? "—" : EditPolicy.ToBusinessTime(utc.Value).ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
}
