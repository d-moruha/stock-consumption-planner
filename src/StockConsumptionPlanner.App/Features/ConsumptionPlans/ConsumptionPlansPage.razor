@page "/consumption-plans"
@rendermode InteractiveServer
@inject GetPlanningSheetHandler PlanningSheetHandler
@inject UpdatePlanHandler UpdateHandler
@inject DeletePlanHandler DeleteHandler
@inject PlanEditPolicy EditPolicy
@inject ConsumptionPlanOptions PlanOptions
@inject IStringLocalizer<ConsumptionPlansResources> L

<PageTitle>@L["PlansTitle"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">@L["PlansTitle"]</h1>
        <p class="text-muted mb-0">
            @L["PlansIntro"]
        </p>
    </div>
    <a class="btn btn-outline-secondary" href="/consumption-plans/orphaned">@L["OrphanedPlansLink"]</a>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert @(_isErrorStatus ? "alert-danger" : "alert-success") d-flex justify-content-between align-items-center" role="alert">
        <span>@_statusMessage</span>
        <button type="button" class="btn-close" @onclick="() => _statusMessage = null" aria-label="@L["Close"]"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label fw-semibold" for="planSearchInput">@L["Search"]</label>
                <input id="planSearchInput"
                       type="search"
                       class="form-control"
                       placeholder="@L["SearchPlaceholder"]"
                       @bind="_search" />
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-primary w-100" disabled="@_isBusy" @onclick="SearchAsync">@L["Search"]</button>
            </div>
        </div>

        <div class="small text-muted mt-3">
            @L[
                "EditRule",
                PlanOptions.EditDaysAfterCreation,
                PlanOptions.LockDaysBeforeTargetMonth,
                EditPolicy.TimeZone.Id]
        </div>
    </div>
</div>

@if (_sheet is null)
{
    <p class="text-muted">@L["Loading"]</p>
}
else if (_sheet.Rows.TotalCount == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h2 class="h5 mb-2">@L["NoStockTitle"]</h2>
            <p class="text-muted mb-3">
                @(string.IsNullOrWhiteSpace(_search) ? L["NoStockReport"] : L["NoStockMatches"])
            </p>
            <a class="btn btn-outline-primary" href="/stock-import">@L["GoToStockImport"]</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm scroll-table-card">
        <div class="table-responsive">
            <table class="plans-stock-table table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th><span class="plans-col-label">@L["ColumnMaterial"]</span></th>
                        <th><span class="plans-col-label">@L["ColumnDescription"]</span></th>
                        <th><span class="plans-col-label">@L["ColumnWbs"]</span></th>
                        <th><span class="plans-col-label">@L["ColumnStorageLocation"]</span></th>
                        <th><span class="plans-col-label">@L["ColumnStock"]</span></th>
                        <th class="stock-balance-col"
                            aria-label="@L["StockBalanceColumn"]"
                            title="@L["StockBalanceColumn"]"></th>
                        <th>
                            <span class="plans-col-label">@L["ColumnUnplannedQuantity"]</span>
                        </th>
                        <th aria-sort="@StockValueAriaSort">
                            <button type="button"
                                    id="stockValueSortButton"
                                    class="plans-col-sort btn btn-link p-0 fw-bold text-body
                                           text-decoration-none"
                                    title="@L["SortByStockValue"]"
                                    disabled="@_isBusy"
                                    @onclick="ToggleStockValueSortAsync">
                                <span class="plans-col-label">
                                    @L["ColumnStockValue"]
                                    <span class="@(IsStockValueSort ? null : "text-muted")"
                                          aria-hidden="true">@StockValueSortIndicator</span>
                                </span>
                            </button>
                        </th>
                        <th><span class="plans-col-label">@L["ColumnGoodsReceiptDate"]</span></th>
                        <th><span class="plans-col-label">@L["ColumnStockCreationDate"]</span></th>
                        <th aria-sort="@StockAgeAriaSort">
                            <button type="button"
                                    id="stockAgeSortButton"
                                    class="plans-col-sort btn btn-link p-0 fw-bold text-body
                                           text-decoration-none"
                                    title="@L["SortByStockAge"]"
                                    disabled="@_isBusy"
                                    @onclick="ToggleStockAgeSortAsync">
                                <span class="plans-col-label">
                                    @L["ColumnStockAge"]
                                    <span class="@(IsStockAgeSort ? null : "text-muted")"
                                          aria-hidden="true">@StockAgeSortIndicator</span>
                                </span>
                            </button>
                        </th>
                        <th><span class="plans-col-label">@L["ColumnPlans"]</span></th>
                        <th><span class="plans-col-label">@L["ColumnActions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (PlanningSheetRowDto row in _sheet.Rows.Items)
                    {
                        StockDocumentKey key = RowKey(row);
                        bool isExpanded = row.Plans.Count > 0 && _expanded.Contains(key);
                        string plansId = $"plans-{row.SourceRowNumber}";
                        <tr @key="key" data-document="@row.MaterialDocumentNumber">
                            <td>@row.MaterialNumber</td>
                            <td class="text-truncate"
                                style="max-width: 18rem;"
                                title="@row.MaterialDescription">
                                @row.MaterialDescription
                            </td>
                            <td class="text-nowrap">@FormatText(row.WbsElement)</td>
                            <td class="text-nowrap">@FormatText(row.StorageLocation)</td>
                            <td class="stock-figure-col">
                                @FormatQuantity(row.CurrentStockQuantity)
                            </td>
                            <td class="stock-balance-col">
                                @if (StockBalanceShare.TryCreate(
                                    row.CurrentStockQuantity,
                                    row.UnplannedQuantity) is { } share)
                                {
                                    <span class="stock-split"
                                          role="img"
                                          aria-label="@BalanceLabel(row)"
                                          title="@BalanceLabel(row)">
                                        @if (share.PlannedPercent > 0)
                                        {
                                            <span class="stock-split-planned"
                                                  style="width:@share.PlannedWidth"></span>
                                        }
                                        @if (share.UnplannedPercent > 0)
                                        {
                                            <span class="stock-split-unplanned"
                                                  style="width:@share.UnplannedWidth"></span>
                                        }
                                        @if (share.OverPercent > 0)
                                        {
                                            <span class="stock-split-over"
                                                  style="width:@share.OverWidth"></span>
                                        }
                                    </span>
                                }
                            </td>
                            <td class="stock-figure-col">@FormatQuantity(row.UnplannedQuantity)</td>
                            <td class="text-end">@FormatMoney(row.TotalStockValue)</td>
                            <td class="text-nowrap">@ConsumptionPlanDisplay.FormatDate(row.GoodsReceiptDate)</td>
                            <td class="text-nowrap">@ConsumptionPlanDisplay.FormatDate(row.StockCreationDate)</td>
                            <td class="text-end">@ConsumptionPlanDisplay.FormatDays(row.StockAgeDays)</td>
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                        disabled="@(row.Plans.Count == 0)"
                                        aria-expanded="@(isExpanded ? "true" : "false")"
                                        aria-controls="@plansId"
                                        @onclick="() => ToggleExpanded(key)">
                                    @L["PlansCount", row.Plans.Count]
                                </button>
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button"
                                        class="btn btn-sm btn-primary"
                                        disabled="@_isBusy"
                                        @onclick="() => OpenDialog(row, null)">
                                    @L["CreatePlan"]
                                </button>
                            </td>
                        </tr>
                        @if (isExpanded)
                        {
                            <tr @key="plansId" id="@plansId">
                                <td colspan="13" class="bg-body-tertiary px-4 py-2">
                                    @RenderPlans(row)
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center gap-3">
            <span class="small text-muted">
                @L["RowsRange", ((_sheet.Rows.Page - 1) * _sheet.Rows.PageSize) + 1, ((_sheet.Rows.Page - 1) * _sheet.Rows.PageSize) + _sheet.Rows.Items.Count, _sheet.Rows.TotalCount]
            </span>
            <span class="stock-split-legend small text-muted text-nowrap">
                <span>
                    <i class="stock-split-swatch stock-split-planned"
                       aria-hidden="true"></i>@L["StockBalancePlanned"]
                </span>
                <span>
                    <i class="stock-split-swatch stock-split-unplanned"
                       aria-hidden="true"></i>@L["StockBalanceUnplanned"]
                </span>
                <span>
                    <i class="stock-split-swatch stock-split-over"
                       aria-hidden="true"></i>@L["StockBalanceOver"]
                </span>
            </span>
            <div class="text-nowrap">
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1 || _isBusy)" @onclick="() => GoToPageAsync(_page - 1)">@L["Previous"]</button>
                <button type="button" class="btn btn-sm btn-outline-secondary ms-1" disabled="@(_page * _sheet.Rows.PageSize >= _sheet.Rows.TotalCount || _isBusy)" @onclick="() => GoToPageAsync(_page + 1)">@L["Next"]</button>
            </div>
        </div>
    </div>
}

@if (_dialogRow is not null)
{
    <PlanDialog Row="_dialogRow"
                Plan="_dialogPlan"
                InitialPeriod="DialogPeriod(_dialogRow, _dialogPlan)"
                Earliest="DialogEarliest(_dialogPlan)"
                CurrentYear="EditPolicy.CurrentMonth.Year"
                OnSaved="OnPlanSavedAsync"
                OnClose="CloseDialog" />
}

@if (_deletePlan is not null)
{
    <DeletePlanDialog Plan="_deletePlan"
                      OnConfirm="ConfirmDeleteAsync"
                      OnClose="() => _deletePlan = null" />
}

@code {
    private string? _search;
    private PlanningSheetSort _sort = PlanningSheetSort.StockValueDescending;
    private int _page = 1;
    private PlanningSheetDto? _sheet;
    private readonly HashSet<StockDocumentKey> _expanded = new();
    private PlanningSheetRowDto? _dialogRow;
    private ConsumptionPlanDto? _dialogPlan;
    private ConsumptionPlanDto? _deletePlan;
    private bool _isBusy;
    private string? _statusMessage;
    private bool _isErrorStatus;

    private const string ExceedsStockBadge =
        "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle";

    private PlanTargetMonth EarliestCreatePeriod => EditPolicy.CurrentMonth.Next();

    private bool IsStockAgeSort =>
        _sort is PlanningSheetSort.StockAgeAscending or PlanningSheetSort.StockAgeDescending;

    private bool IsStockValueSort =>
        _sort is PlanningSheetSort.StockValueAscending or PlanningSheetSort.StockValueDescending;

    private string StockValueAriaSort => _sort switch
    {
        PlanningSheetSort.StockValueAscending => "ascending",
        PlanningSheetSort.StockValueDescending => "descending",
        _ => "none"
    };

    private string StockValueSortIndicator => _sort switch
    {
        PlanningSheetSort.StockValueAscending => "▲",
        PlanningSheetSort.StockValueDescending => "▼",
        _ => "↕"
    };

    private string StockAgeAriaSort => _sort switch
    {
        PlanningSheetSort.StockAgeAscending => "ascending",
        PlanningSheetSort.StockAgeDescending => "descending",
        _ => "none"
    };

    private string StockAgeSortIndicator => _sort switch
    {
        PlanningSheetSort.StockAgeAscending => "▲",
        PlanningSheetSort.StockAgeDescending => "▼",
        _ => "↕"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private RenderFragment RenderPlans(PlanningSheetRowDto row) =>
        @<table class="table table-sm table-borderless align-middle mb-0 bg-transparent">
            <tbody>
                <tr class="small text-muted">
                    <th scope="col" class="bg-transparent">@L["ColumnPeriod"]</th>
                    <th scope="col" class="bg-transparent" style="width: 11rem;">
                        @L["ColumnPlanned"]
                    </th>
                    <th scope="col" class="bg-transparent">@L["ColumnEditableUntil"]</th>
                    <th scope="col" class="bg-transparent text-end">@L["ColumnActions"]</th>
                </tr>
                @foreach (ConsumptionPlanDto plan in row.Plans)
                {
                    <tr @key="plan.Id">
                        <td class="bg-transparent">
                            @FormatPeriod(plan)
                        </td>
                        <td class="bg-transparent">
                            @FormatQuantity(plan.PlannedQuantity)
                            @if (plan.ExceedsStock)
                            {
                                <span class="@ExceedsStockBadge ms-1">@L["ExceedsStock"]</span>
                            }
                        </td>
                        <td class="bg-transparent small text-muted">
                            @FormatLocal(plan.EditableUntilUtc)
                        </td>
                        <td class="bg-transparent text-end text-nowrap">
                            <button type="button"
                                    class="btn btn-sm btn-primary"
                                    disabled="@(!plan.IsEditable || _isBusy)"
                                    @onclick="() => OpenDialog(row, plan)">
                                @L["Edit"]
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger ms-1"
                                    disabled="@(!plan.CanDelete || _isBusy)"
                                    @onclick="() => _deletePlan = plan">
                                @L["Delete"]
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>;

    private async Task LoadAsync()
    {
        _isBusy = true;
        try
        {
            ConsumptionPlanResult<PlanningSheetDto> result = await PlanningSheetHandler.HandleAsync(
                new PlanningSheetQuery(
                    EarliestCreatePeriod.Year,
                    EarliestCreatePeriod.Month,
                    _search,
                    _page,
                    Sort: _sort));
            if (result.IsSuccess)
            {
                _sheet = result.Value;
            }
            else
            {
                _isErrorStatus = true;
                _statusMessage = L["LoadFailed"];
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ToggleStockAgeSortAsync()
    {
        _sort = _sort switch
        {
            PlanningSheetSort.StockAgeAscending => PlanningSheetSort.StockAgeDescending,
            PlanningSheetSort.StockAgeDescending => PlanningSheetSort.SourceRow,
            _ => PlanningSheetSort.StockAgeAscending
        };
        _page = 1;
        await LoadAsync();
    }

    private async Task ToggleStockValueSortAsync()
    {
        _sort = _sort switch
        {
            PlanningSheetSort.StockValueAscending => PlanningSheetSort.StockValueDescending,
            PlanningSheetSort.StockValueDescending => PlanningSheetSort.SourceRow,
            _ => PlanningSheetSort.StockValueAscending
        };
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = Math.Max(1, page);
        await LoadAsync();
    }

    private void ToggleExpanded(StockDocumentKey key)
    {
        if (!_expanded.Remove(key))
        {
            _expanded.Add(key);
        }
    }

    private void OpenDialog(PlanningSheetRowDto row, ConsumptionPlanDto? plan)
    {
        _dialogRow = row;
        _dialogPlan = plan;
    }

    private void CloseDialog()
    {
        _dialogRow = null;
        _dialogPlan = null;
    }

    private PlanTargetMonth DialogPeriod(PlanningSheetRowDto row, ConsumptionPlanDto? plan)
    {
        if (plan is not null)
        {
            return PlanPeriod(plan);
        }

        PlanTargetMonth period = EarliestCreatePeriod;
        while (row.Plans.Any(p => p.TargetYear == period.Year && p.TargetMonth == period.Month))
        {
            period = period.Next();
        }

        return period;
    }

    private PlanTargetMonth DialogEarliest(ConsumptionPlanDto? plan)
    {
        return plan is not null && PlanPeriod(plan).CompareTo(EarliestCreatePeriod) < 0
            ? PlanPeriod(plan)
            : EarliestCreatePeriod;
    }

    private async Task OnPlanSavedAsync(ConsumptionPlanDto plan)
    {
        StockDocumentKey key = PlanKey(plan);
        CloseDialog();
        _expanded.Add(key);
        _isErrorStatus = false;
        _statusMessage = L["PlanSaved", key.ToString(), FormatPeriod(plan)];
        await LoadAsync();
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deletePlan is { } plan)
        {
            await DeleteAsync(plan);
            _deletePlan = null;
        }
    }

    private async Task DeleteAsync(ConsumptionPlanDto plan)
    {
        _isBusy = true;
        try
        {
            ConsumptionPlanResult<bool> result = await DeleteHandler.HandleAsync(plan.Id, plan.Version);
            if (result.IsSuccess)
            {
                _isErrorStatus = false;
                _statusMessage = L["PlanDeleted", PlanKey(plan).ToString()];
                await LoadAsync();
            }
            else
            {
                ShowError(result.Error!, plan);
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ShowError(ConsumptionPlanError error, ConsumptionPlanDto plan)
    {
        _isErrorStatus = true;
        _statusMessage = ConsumptionPlanDisplay.LocalizeError(
            L,
            error,
            PlanKey(plan),
            PlanPeriod(plan));
    }

    private static StockDocumentKey RowKey(PlanningSheetRowDto row) =>
        new(row.MaterialDocumentYear, row.MaterialDocumentNumber, row.MaterialDocumentItem);

    private static StockDocumentKey PlanKey(ConsumptionPlanDto plan) =>
        new(plan.MaterialDocumentYear, plan.MaterialDocumentNumber, plan.MaterialDocumentItem);

    private static PlanTargetMonth PlanPeriod(ConsumptionPlanDto plan) =>
        new(plan.TargetYear, plan.TargetMonth);

    private static string FormatPeriod(ConsumptionPlanDto plan) =>
        ConsumptionPlanDisplay.FormatMonth(plan.TargetYear, plan.TargetMonth);

    private string FormatLocal(DateTimeOffset utc) => ConsumptionPlanDisplay.FormatBusinessTime(EditPolicy, utc);

    private string BalanceLabel(PlanningSheetRowDto row)
    {
        return L[
            "StockBalanceLabel",
            FormatQuantity(row.CurrentStockQuantity),
            FormatQuantity(row.UnplannedQuantity)];
    }

    private static string FormatText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "—" : value;
    }

    private static string FormatQuantity(decimal? value)
    {
        return ConsumptionPlanDisplay.FormatQuantity(value);
    }

    private static string FormatMoney(decimal? value)
    {
        return ConsumptionPlanDisplay.FormatMoney(value);
    }
}
