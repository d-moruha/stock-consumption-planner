@page "/consumption-plans"
@rendermode InteractiveServer
@inject GetPlanningSheetHandler PlanningSheetHandler
@inject UpdatePlanHandler UpdateHandler
@inject DeletePlanHandler DeleteHandler
@inject PlanEditPolicy EditPolicy
@inject ConsumptionPlanOptions PlanOptions
@inject IStringLocalizer<ConsumptionPlansResources> L

<PageTitle>@L["PlansTitle"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">@L["PlansTitle"]</h1>
        <p class="text-muted mb-0">
            @L["PlansIntro"]
        </p>
    </div>
    <a class="btn btn-outline-secondary" href="/consumption-plans/orphaned">@L["OrphanedPlansLink"]</a>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert @(_isErrorStatus ? "alert-danger" : "alert-success") d-flex justify-content-between align-items-center" role="alert">
        <span>@_statusMessage</span>
        <button type="button" class="btn-close" @onclick="() => _statusMessage = null" aria-label="@L["Close"]"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-start">
            <div class="col-md-5">
                <PlanPeriodPicker Period="_target"
                                  CurrentYear="EditPolicy.CurrentMonth.Year"
                                  PeriodChanged="OnPeriodChangedAsync" />
            </div>
            <div class="col-md-5">
                <label class="form-label fw-semibold" for="planSearchInput">@L["Search"]</label>
                <input id="planSearchInput"
                       type="search"
                       class="form-control"
                       placeholder="@L["SearchPlaceholder"]"
                       @bind="_search" />
            </div>
            <div class="col-md-2">
                <span class="form-label d-none d-md-block" aria-hidden="true">&nbsp;</span>
                <button type="button"
                        class="btn btn-primary w-100"
                        disabled="@(_isBusy || !_isPeriodValid)"
                        @onclick="SearchAsync">
                    @L["Search"]
                </button>
            </div>
        </div>

        @if (_sheet is not null && _isPeriodValid)
        {
            <div class="small text-muted mt-3">
                @L["EditRulePrefix", PlanOptions.EditDaysAfterCreation]
                <strong>@FormatLocal(_sheet.LockBeforeMonthUtc)</strong>
                @L["EditRuleSuffix", PlanOptions.LockDaysBeforeTargetMonth, ConsumptionPlanDisplay.FormatMonth(_target), EditPolicy.TimeZone.Id]
            </div>
        }
    </div>
</div>

@if (!_isPeriodValid)
{
    <div class="alert alert-warning" role="status">@L["PlanPeriodInvalid"]</div>
}
else if (_sheet is null)
{
    <p class="text-muted">@L["Loading"]</p>
}
else if (_sheet.Rows.TotalCount == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h2 class="h5 mb-2">@L["NoStockTitle"]</h2>
            <p class="text-muted mb-3">
                @(string.IsNullOrWhiteSpace(_search) ? L["NoStockReport"] : L["NoStockMatches"])
            </p>
            <a class="btn btn-outline-primary" href="/stock-import">@L["GoToStockImport"]</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm scroll-table-card">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@L["ColumnDocument"]</th>
                        <th>@L["ColumnItem"]</th>
                        <th>@L["ColumnYear"]</th>
                        <th>@L["ColumnMaterial"]</th>
                        <th>@L["ColumnDescription"]</th>
                        <th class="text-end">@L["ColumnStock"]</th>
                        <th class="text-end">
                            @L["ColumnPlannedFor", ConsumptionPlanDisplay.FormatMonth(_target)]
                        </th>
                        <th>@L["ColumnPlans"]</th>
                        <th class="text-end">@L["ColumnActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (PlanningSheetRowDto row in _sheet.Rows.Items)
                    {
                        StockDocumentKey key = RowKey(row);
                        bool isExpanded = row.Plans.Count > 0 && _expanded.Contains(key);
                        string plansId = $"plans-{row.SourceRowNumber}";
                        <tr @key="key">
                            <td><code>@row.MaterialDocumentNumber</code></td>
                            <td><code>@row.MaterialDocumentItem</code></td>
                            <td>@row.MaterialDocumentYear</td>
                            <td>@row.MaterialNumber</td>
                            <td class="text-truncate" style="max-width: 18rem;" title="@row.MaterialDescription">@row.MaterialDescription</td>
                            <td class="text-end">@FormatQuantity(row.CurrentStockQuantity)</td>
                            <td class="text-end">
                                @(row.Plan is null ? "—" : FormatQuantity(row.Plan.PlannedQuantity))
                                @if (row.Plan?.ExceedsStock == true)
                                {
                                    <span class="@ExceedsStockBadge ms-1">@L["ExceedsStock"]</span>
                                }
                            </td>
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                        disabled="@(row.Plans.Count == 0)"
                                        aria-expanded="@(isExpanded ? "true" : "false")"
                                        aria-controls="@plansId"
                                        @onclick="() => ToggleExpanded(key)">
                                    @L["PlansCount", row.Plans.Count]
                                </button>
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button"
                                        class="btn btn-sm btn-primary"
                                        disabled="@_isBusy"
                                        @onclick="() => OpenDialog(row, null)">
                                    @L["CreatePlan"]
                                </button>
                            </td>
                        </tr>
                        @if (isExpanded)
                        {
                            <tr @key="plansId" id="@plansId">
                                <td colspan="9" class="bg-body-tertiary px-4 py-2">
                                    @RenderPlans(row)
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <span class="small text-muted">
                @L["RowsRange", ((_sheet.Rows.Page - 1) * _sheet.Rows.PageSize) + 1, ((_sheet.Rows.Page - 1) * _sheet.Rows.PageSize) + _sheet.Rows.Items.Count, _sheet.Rows.TotalCount]
            </span>
            <div>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1 || _isBusy)" @onclick="() => GoToPageAsync(_page - 1)">@L["Previous"]</button>
                <button type="button" class="btn btn-sm btn-outline-secondary ms-1" disabled="@(_page * _sheet.Rows.PageSize >= _sheet.Rows.TotalCount || _isBusy)" @onclick="() => GoToPageAsync(_page + 1)">@L["Next"]</button>
            </div>
        </div>
    </div>
}

@if (_dialogRow is not null)
{
    <PlanDialog Row="_dialogRow"
                Plan="_dialogPlan"
                InitialPeriod="DialogPeriod(_dialogRow, _dialogPlan)"
                Earliest="DialogEarliest(_dialogPlan)"
                CurrentYear="EditPolicy.CurrentMonth.Year"
                OnSaved="OnPlanSavedAsync"
                OnClose="CloseDialog" />
}

@code {
    private PlanTargetMonth _target;
    private string? _search;
    private int _page = 1;
    private PlanningSheetDto? _sheet;
    private readonly HashSet<StockDocumentKey> _expanded = new();
    private PlanningSheetRowDto? _dialogRow;
    private ConsumptionPlanDto? _dialogPlan;
    private bool _isBusy;
    private string? _statusMessage;
    private bool _isErrorStatus;
    private bool _isPeriodValid = true;

    private const string ExceedsStockBadge =
        "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle";

    private PlanTargetMonth EarliestCreatePeriod => EditPolicy.CurrentMonth.Next();

    protected override async Task OnInitializedAsync()
    {
        _target = EditPolicy.CurrentMonth.Next();
        await LoadAsync();
    }

    private RenderFragment RenderPlans(PlanningSheetRowDto row) =>
        @<table class="table table-sm table-borderless align-middle mb-0 bg-transparent">
            <tbody>
                <tr class="small text-muted">
                    <th scope="col" class="bg-transparent">@L["ColumnPeriod"]</th>
                    <th scope="col" class="bg-transparent" style="width: 11rem;">
                        @L["ColumnPlanned"]
                    </th>
                    <th scope="col" class="bg-transparent">@L["ColumnEditableUntil"]</th>
                    <th scope="col" class="bg-transparent text-end">@L["ColumnActions"]</th>
                </tr>
                @foreach (ConsumptionPlanDto plan in row.Plans)
                {
                    <tr @key="plan.Id">
                        <td class="bg-transparent @(IsSelected(plan) ? "fw-semibold" : null)">
                            @FormatPeriod(plan)
                        </td>
                        <td class="bg-transparent">
                            @FormatQuantity(plan.PlannedQuantity)
                            @if (plan.ExceedsStock)
                            {
                                <span class="@ExceedsStockBadge ms-1">@L["ExceedsStock"]</span>
                            }
                        </td>
                        <td class="bg-transparent small text-muted">
                            @FormatLocal(plan.EditableUntilUtc)
                        </td>
                        <td class="bg-transparent text-end text-nowrap">
                            <button type="button"
                                    class="btn btn-sm btn-primary"
                                    disabled="@(!plan.IsEditable || _isBusy)"
                                    @onclick="() => OpenDialog(row, plan)">
                                @L["Edit"]
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger ms-1"
                                    disabled="@(!plan.CanDelete || _isBusy)"
                                    @onclick="() => DeleteAsync(plan)">
                                @L["Delete"]
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>;

    private async Task LoadAsync()
    {
        if (!_isPeriodValid)
        {
            return;
        }

        _isBusy = true;
        try
        {
            ConsumptionPlanResult<PlanningSheetDto> result = await PlanningSheetHandler.HandleAsync(
                new PlanningSheetQuery(_target.Year, _target.Month, _search, _page));
            if (result.IsSuccess)
            {
                _sheet = result.Value;
            }
            else
            {
                _isErrorStatus = true;
                _statusMessage = L["LoadFailed", ConsumptionPlanDisplay.FormatMonth(_target)];
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task OnPeriodChangedAsync(PlanTargetMonth? period)
    {
        if (period is null)
        {
            _isPeriodValid = false;
            return;
        }

        if (_isPeriodValid && period.Value == _target)
        {
            return;
        }

        _target = period.Value;
        _isPeriodValid = true;
        _page = 1;
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = Math.Max(1, page);
        await LoadAsync();
    }

    private void ToggleExpanded(StockDocumentKey key)
    {
        if (!_expanded.Remove(key))
        {
            _expanded.Add(key);
        }
    }

    private void OpenDialog(PlanningSheetRowDto row, ConsumptionPlanDto? plan)
    {
        _dialogRow = row;
        _dialogPlan = plan;
    }

    private void CloseDialog()
    {
        _dialogRow = null;
        _dialogPlan = null;
    }

    private PlanTargetMonth DialogPeriod(PlanningSheetRowDto row, ConsumptionPlanDto? plan)
    {
        if (plan is not null)
        {
            return PlanPeriod(plan);
        }

        PlanTargetMonth period = _isPeriodValid && _target.CompareTo(EarliestCreatePeriod) > 0
            ? _target
            : EarliestCreatePeriod;
        while (row.Plans.Any(p => p.TargetYear == period.Year && p.TargetMonth == period.Month))
        {
            period = period.Next();
        }

        return period;
    }

    private PlanTargetMonth DialogEarliest(ConsumptionPlanDto? plan)
    {
        return plan is not null && PlanPeriod(plan).CompareTo(EarliestCreatePeriod) < 0
            ? PlanPeriod(plan)
            : EarliestCreatePeriod;
    }

    private async Task OnPlanSavedAsync(ConsumptionPlanDto plan)
    {
        StockDocumentKey key = PlanKey(plan);
        CloseDialog();
        _expanded.Add(key);
        _isErrorStatus = false;
        _statusMessage = L["PlanSaved", key.ToString(), FormatPeriod(plan)];
        await LoadAsync();
    }

    private async Task DeleteAsync(ConsumptionPlanDto plan)
    {
        _isBusy = true;
        try
        {
            ConsumptionPlanResult<bool> result = await DeleteHandler.HandleAsync(plan.Id, plan.Version);
            if (result.IsSuccess)
            {
                _isErrorStatus = false;
                _statusMessage = L["PlanDeleted", PlanKey(plan).ToString()];
                await LoadAsync();
            }
            else
            {
                ShowError(result.Error!, plan);
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ShowError(ConsumptionPlanError error, ConsumptionPlanDto plan)
    {
        _isErrorStatus = true;
        _statusMessage = ConsumptionPlanDisplay.LocalizeError(
            L,
            error,
            PlanKey(plan),
            PlanPeriod(plan));
    }

    private static StockDocumentKey RowKey(PlanningSheetRowDto row) =>
        new(row.MaterialDocumentYear, row.MaterialDocumentNumber, row.MaterialDocumentItem);

    private static StockDocumentKey PlanKey(ConsumptionPlanDto plan) =>
        new(plan.MaterialDocumentYear, plan.MaterialDocumentNumber, plan.MaterialDocumentItem);

    private bool IsSelected(ConsumptionPlanDto plan) => PlanPeriod(plan) == _target;

    private static PlanTargetMonth PlanPeriod(ConsumptionPlanDto plan) =>
        new(plan.TargetYear, plan.TargetMonth);

    private static string FormatPeriod(ConsumptionPlanDto plan) =>
        ConsumptionPlanDisplay.FormatMonth(plan.TargetYear, plan.TargetMonth);

    private string FormatLocal(DateTimeOffset utc) => ConsumptionPlanDisplay.FormatBusinessTime(EditPolicy, utc);

    private static string FormatQuantity(decimal value) => ConsumptionPlanDisplay.FormatQuantity(value);
}
