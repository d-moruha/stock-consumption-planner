@page "/consumption-plans"
@rendermode InteractiveServer
@using System.Globalization
@inject GetPlanningSheetHandler PlanningSheetHandler
@inject CreatePlanHandler CreateHandler
@inject UpdatePlanHandler UpdateHandler
@inject DeletePlanHandler DeleteHandler
@inject PlanEditPolicy EditPolicy
@inject ConsumptionPlanOptions PlanOptions

<PageTitle>Consumption Plans</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Consumption Plans</h1>
        <p class="text-muted mb-0">
            Plan how much of each current stock record is consumed in a month. One plan per stock record per month.
        </p>
    </div>
    <a class="btn btn-outline-secondary" href="/consumption-plans/orphaned">Orphaned Plans</a>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert @(_isErrorStatus ? "alert-danger" : "alert-success") d-flex justify-content-between align-items-center" role="alert">
        <span>@_statusMessage</span>
        <button type="button" class="btn-close" @onclick="() => _statusMessage = null" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold" for="targetMonthInput">Target Month</label>
                <input id="targetMonthInput"
                       type="month"
                       class="form-control"
                       value="@_target.ToString()"
                       @onchange="OnMonthChangedAsync" />
            </div>
            <div class="col-md-5">
                <label class="form-label fw-semibold" for="planSearchInput">Search</label>
                <input id="planSearchInput"
                       type="search"
                       class="form-control"
                       placeholder="Material number, description, or document number"
                       @bind="_search" />
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-primary w-100" disabled="@_isBusy" @onclick="SearchAsync">Search</button>
            </div>
        </div>

        @if (_sheet is not null)
        {
            <div class="small text-muted mt-3">
                @if (_sheet.CanCreate)
                {
                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle me-2">New plans allowed</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle me-2">Month has ended</span>
                }
                A plan can be changed for @PlanOptions.EditDaysAfterCreation days after it is created, and otherwise until
                <strong>@FormatLocal(_sheet.LockBeforeMonthUtc)</strong> (@PlanOptions.LockDaysBeforeTargetMonth days before @_target).
                Times are in @EditPolicy.TimeZone.Id.
            </div>
        }
    </div>
</div>

@if (_sheet is null)
{
    <p class="text-muted">Loading…</p>
}
else if (_sheet.Rows.TotalCount == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h2 class="h5 mb-2">No Stock to Plan</h2>
            <p class="text-muted mb-3">
                @(string.IsNullOrWhiteSpace(_search) ? "No current stock report is loaded." : "No stock records match the search.")
            </p>
            <a class="btn btn-outline-primary" href="/stock-import">Go to Stock Report Import</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Document</th>
                        <th>Item</th>
                        <th>Year</th>
                        <th>Material</th>
                        <th>Description</th>
                        <th class="text-end">Stock</th>
                        <th style="width: 11rem;">Planned</th>
                        <th>Editable Until</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (PlanningSheetRowDto row in _sheet.Rows.Items)
                    {
                        StockDocumentKey key = new(row.MaterialDocumentYear, row.MaterialDocumentNumber, row.MaterialDocumentItem);
                        ConsumptionPlanDto? plan = row.Plan;
                        bool canSave = plan is null ? _sheet.CanCreate : plan.IsEditable;
                        <tr @key="key">
                            <td><code>@row.MaterialDocumentNumber</code></td>
                            <td><code>@row.MaterialDocumentItem</code></td>
                            <td>@row.MaterialDocumentYear</td>
                            <td>@row.MaterialNumber</td>
                            <td class="text-truncate" style="max-width: 18rem;" title="@row.MaterialDescription">@row.MaterialDescription</td>
                            <td class="text-end">@FormatQuantity(row.CurrentStockQuantity)</td>
                            <td>
                                <input type="number"
                                       min="0"
                                       step="any"
                                       class="form-control form-control-sm"
                                       disabled="@(!canSave || _isBusy)"
                                       value="@GetDraft(key, plan)"
                                       @onchange="args => _drafts[key] = args.Value?.ToString() ?? string.Empty" />
                                @if (plan?.ExceedsStock == true)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle mt-1">Exceeds stock</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @(plan is null ? "—" : FormatLocal(plan.EditableUntilUtc))
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button"
                                        class="btn btn-sm btn-primary"
                                        disabled="@(!canSave || _isBusy)"
                                        @onclick="() => SaveAsync(key, plan)">
                                    @(plan is null ? "Create" : "Save")
                                </button>
                                @if (plan is not null)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger ms-1"
                                            disabled="@(!plan.CanDelete || _isBusy)"
                                            @onclick="() => DeleteAsync(plan)">
                                        Delete
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <span class="small text-muted">
                Rows @(((_sheet.Rows.Page - 1) * _sheet.Rows.PageSize) + 1)–@(((_sheet.Rows.Page - 1) * _sheet.Rows.PageSize) + _sheet.Rows.Items.Count)
                of @_sheet.Rows.TotalCount
            </span>
            <div>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1 || _isBusy)" @onclick="() => GoToPageAsync(_page - 1)">Previous</button>
                <button type="button" class="btn btn-sm btn-outline-secondary ms-1" disabled="@(_page * _sheet.Rows.PageSize >= _sheet.Rows.TotalCount || _isBusy)" @onclick="() => GoToPageAsync(_page + 1)">Next</button>
            </div>
        </div>
    </div>
}

@code {
    private PlanTargetMonth _target;
    private string? _search;
    private int _page = 1;
    private PlanningSheetDto? _sheet;
    private readonly Dictionary<StockDocumentKey, string> _drafts = new();
    private bool _isBusy;
    private string? _statusMessage;
    private bool _isErrorStatus;

    protected override async Task OnInitializedAsync()
    {
        _target = EditPolicy.CurrentMonth.Next();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isBusy = true;
        try
        {
            ConsumptionPlanResult<PlanningSheetDto> result = await PlanningSheetHandler.HandleAsync(
                new PlanningSheetQuery(_target.Year, _target.Month, _search, _page));
            if (result.IsSuccess)
            {
                _sheet = result.Value;
                _drafts.Clear();
            }
            else
            {
                ShowError(result.Error!);
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task OnMonthChangedAsync(ChangeEventArgs args)
    {
        if (PlanTargetMonth.TryParse(args.Value?.ToString(), out PlanTargetMonth month))
        {
            _target = month;
            _page = 1;
            await LoadAsync();
        }
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = Math.Max(1, page);
        await LoadAsync();
    }

    private string GetDraft(StockDocumentKey key, ConsumptionPlanDto? plan)
    {
        return _drafts.TryGetValue(key, out string? draft)
            ? draft
            : plan?.PlannedQuantity.ToString("0.####", CultureInfo.InvariantCulture) ?? string.Empty;
    }

    private async Task SaveAsync(StockDocumentKey key, ConsumptionPlanDto? plan)
    {
        string text = GetDraft(key, plan).Trim().Replace(',', '.');
        if (!decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal quantity))
        {
            _isErrorStatus = true;
            _statusMessage = $"Enter a planned quantity for {key}.";
            return;
        }

        _isBusy = true;
        try
        {
            ConsumptionPlanResult<ConsumptionPlanDto> result = plan is null
                ? await CreateHandler.HandleAsync(new CreateConsumptionPlanRequest(
                    key.MaterialDocumentYear,
                    key.MaterialDocumentNumber,
                    key.MaterialDocumentItem,
                    _target.Year,
                    _target.Month,
                    quantity))
                : await UpdateHandler.HandleAsync(plan.Id, new UpdateConsumptionPlanRequest(quantity, plan.Version));

            if (result.IsSuccess)
            {
                _isErrorStatus = false;
                _statusMessage = $"Plan for {key} in {_target} saved.";
                await LoadAsync();
            }
            else
            {
                ShowError(result.Error!);
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteAsync(ConsumptionPlanDto plan)
    {
        _isBusy = true;
        try
        {
            ConsumptionPlanResult<bool> result = await DeleteHandler.HandleAsync(plan.Id, plan.Version);
            if (result.IsSuccess)
            {
                _isErrorStatus = false;
                _statusMessage = $"Plan for {plan.MaterialDocumentYear}/{plan.MaterialDocumentNumber}/{plan.MaterialDocumentItem} deleted.";
                await LoadAsync();
            }
            else
            {
                ShowError(result.Error!);
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ShowError(ConsumptionPlanError error)
    {
        _isErrorStatus = true;
        _statusMessage = error.Code == ConsumptionPlanErrorCode.StaleVersion
            ? $"{error.Message} Use Search to reload."
            : error.Message;
    }

    private string FormatLocal(DateTimeOffset utc) => EditPolicy.ToBusinessTime(utc).ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);

    private static string FormatQuantity(decimal value) => value.ToString("#,0.####", CultureInfo.InvariantCulture);
}
