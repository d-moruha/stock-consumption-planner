@page "/stock-import"
@rendermode InteractiveServer
@using System.Globalization
@using System.Text.Json
@inject IStockReportExcelInspector ExcelInspector
@inject IStockReportExcelParser ExcelParser
@inject IStockReportRepository StockReportRepository
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<StockReportResources> L

<PageTitle>@L["ImportPageTitle"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">@L["ImportHeading"]</h1>
        <p class="text-muted mb-0">
            @L["ImportIntro"]
        </p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert @(_isErrorStatus ? "alert-danger" : "alert-success") d-flex justify-content-between align-items-center" role="alert">
        <span>@_statusMessage</span>
        <button type="button" class="btn-close" @onclick="() => _statusMessage = null" aria-label="@L["Close"]"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold">@L["Step1Title"]</span>
        @if (!string.IsNullOrWhiteSpace(_uploadedFileName))
        {
            <span class="badge bg-primary">@_uploadedFileName</span>
        }
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-semibold" for="excelFileInput">@L["ExcelWorkbook"]</label>
                <InputFile id="excelFileInput" class="form-control" accept=".xlsx" OnChange="OnFileSelectedAsync" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold" for="sheetSelector">@L["Worksheet"]</label>
                <select id="sheetSelector"
                        class="form-select"
                        disabled="@(_inspection is null)"
                        value="@_selectedSheetName"
                        @onchange="OnSheetChangedAsync">
                    @if (_inspection is not null)
                    {
                        @foreach (string sheet in _inspection.SheetNames)
                        {
                            <option value="@sheet">@sheet</option>
                        }
                    }
                    else
                    {
                        <option value="">@L["UploadFileFirst"]</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold" for="headerRowInput">@L["HeaderRow"]</label>
                <input id="headerRowInput"
                       type="number"
                       min="1"
                       class="form-control"
                       value="@_headerRowNumber"
                       @onchange="OnHeaderRowChanged" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold" for="dataStartRowInput">@L["DataStartRow"]</label>
                <input id="dataStartRowInput"
                       type="number"
                       min="@(_headerRowNumber + 1)"
                       class="form-control"
                       @bind="_dataStartRowNumber" />
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="button"
                    class="btn btn-outline-primary btn-sm"
                    disabled="@(_fileBytes is null || _isBusy)"
                    @onclick="ReinspectCurrentFileAsync">
                @L["Reinspect"]
            </button>
            <button type="button"
                    class="btn btn-outline-secondary btn-sm"
                    disabled="@(_inspection is null)"
                    @onclick="ApplyAutoSuggestedMapping">
                @L["ResetMapping"]
            </button>
            <button type="button"
                    class="btn btn-outline-secondary btn-sm"
                    disabled="@(_inspection is null)"
                    @onclick="LoadSavedMappingFromStorageAsync">
                @L["LoadSavedMapping"]
            </button>
            <button type="button"
                    class="btn btn-outline-secondary btn-sm"
                    disabled="@(_inspection is null)"
                    @onclick="SaveMappingToStorageAsync">
                @L["SaveMapping"]
            </button>
        </div>
    </div>
</div>

@if (_inspection is not null)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <span class="fw-semibold">@L["Step2Title", StockReportFieldCatalog.All.Count]</span>
            <span class="small text-muted">
                @L["DetectedColumns", _inspection.Columns.Count, GetMappedColumnCount(), GetIgnoredColumns().Count]
            </span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-3">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 24%;">@L["TargetField"]</th>
                            <th style="width: 24%;">@L["ExpectedHeader"]</th>
                            <th style="width: 34%;">@L["ExcelColumnMapping"]</th>
                            <th style="width: 18%;">@L["SampleValues"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (StockReportFieldMetadata metadata in StockReportFieldCatalog.All)
                        {
                            int selectedCol = GetSelectedColumn(metadata.Field);
                            DetectedExcelColumnDto? colInfo = _inspection.Columns.FirstOrDefault(c => c.ColumnIndex == selectedCol);

                            <tr>
                                <td>
                                    <div class="fw-semibold">@metadata.GetLocalizedName()</div>
                                    <code class="small">@metadata.Key</code>
                                    <span class="badge bg-light text-dark border ms-1">@metadata.GetLocalizedTypeName(L)</span>
                                    <span class="badge @(metadata.IsRequired ? "bg-danger-subtle text-danger-emphasis" : "bg-light text-muted") border ms-1">@(metadata.IsRequired ? L["Required"] : L["Optional"])</span>
                                </td>
                                <td>
                                    <div>@metadata.UkrainianName</div>
                                    <div class="small text-muted">@metadata.GetLocalizedDescription(L)</div>
                                </td>
                                <td>
                                    <select class="form-select @(selectedCol > 0 ? "border-success" : metadata.IsRequired ? "border-danger" : null)"
                                            value="@selectedCol"
                                            @onchange="e => OnFieldColumnChanged(metadata.Field, e.Value?.ToString())">
                                        <option value="0">@L["SelectExcelColumn"]</option>
                                        @foreach (DetectedExcelColumnDto column in _inspection.Columns)
                                        {
                                            string samplePreview = column.SampleValues.Count > 0
                                                ? " " + L["SamplePreview", string.Join(", ", column.SampleValues.Take(2))]
                                                : string.Empty;
                                            <option value="@column.ColumnIndex">
                                                [@column.ColumnLetter] @column.HeaderText@samplePreview
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    @if (colInfo is not null && colInfo.SampleValues.Count > 0)
                                    {
                                        <div class="small text-truncate" style="max-width: 240px;" title="@string.Join(" | ", colInfo.SampleValues)">
                                            @string.Join(" | ", colInfo.SampleValues)
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@L["NoSample"]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="border rounded p-3 bg-light">
                <div class="small fw-semibold text-uppercase text-muted mb-2">@L["ColumnDisposition"]</div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (DetectedExcelColumnDto col in _inspection.Columns)
                    {
                        StockReportField? mappedField = GetFieldForColumn(col.ColumnIndex);
                        if (mappedField.HasValue)
                        {
                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle px-2 py-1">
                                [@col.ColumnLetter] @col.HeaderText &rarr; @mappedField.Value.GetLocalizedName()
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-2 py-1">
                                [@col.ColumnLetter] @col.HeaderText @L["Ignored"]
                            </span>
                        }
                    }
                </div>
            </div>

            <div class="mt-3 d-flex justify-content-end">
                <button type="button"
                        class="btn btn-primary"
                        disabled="@(!AreRequiredFieldsMapped() || _isBusy)"
                        @onclick="ExecuteImportAsync">
                    @L["ImportButton"]
                </button>
            </div>
        </div>
    </div>
}

@if (_lastImportResult is not null && _lastImportResult.Errors.Count > 0)
{
    <div class="card border-warning shadow-sm mb-4">
        <div class="card-header bg-warning-subtle text-warning-emphasis py-2 fw-semibold">
            @L["RowErrorsTitle", _lastImportResult.Errors.Count, _lastImportResult.ErrorRowCount]
        </div>
        <div class="table-responsive" style="max-height: 240px;">
            <table class="table table-sm table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>@L["RowNumber"]</th>
                        <th>@L["Field"]</th>
                        <th>@L["RawValue"]</th>
                        <th>@L["Message"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (StockReportRowErrorDto err in _lastImportResult.Errors)
                    {
                        <tr>
                            <td><code>@err.RowNumber</code></td>
                            <td>@StockReportFieldLocalization.GetLocalizedFieldName(err.Field)</td>
                            <td><code>@(err.RawValue ?? L["Empty"])</code></td>
                            <td class="text-danger">@LocalizeRowError(err)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <span class="fw-semibold">@L["Step3Title"]</span>
            @if (_currentBatch is not null)
            {
                <span class="text-muted small ms-2">
                    @L["StoredReportSummary", _currentBatch.SourceFileName, _currentBatch.SheetName, _currentBatch.TotalRows]
                </span>
            }
        </div>
        <div class="d-flex gap-2 align-items-center">
            <input type="search"
                   class="form-control form-control-sm"
                   style="min-width: 260px;"
                   placeholder="@L["SearchPlaceholder"]"
                   @bind="_searchQuery"
                   @bind:event="oninput" />
            @if (_currentBatch is not null)
            {
                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="ClearStoredReportAsync">
                    @L["Clear"]
                </button>
            }
        </div>
    </div>

    @if (_currentBatch is null || _currentBatch.Items.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">
            @L["NoItems"]
        </div>
    }
    else
    {
        IReadOnlyList<StockReportItem> filteredItems = GetFilteredItems();

        <div class="card-body border-bottom bg-light py-2">
            <div class="row text-center">
                <div class="col-sm-3">
                    <span class="text-muted small">@L["ValidRows"]</span>
                    <strong class="ms-1">@_currentBatch.TotalRows</strong>
                    @if (filteredItems.Count != _currentBatch.TotalRows)
                    {
                        <span class="text-muted small">@L["Showing", filteredItems.Count]</span>
                    }
                </div>
                <div class="col-sm-3">
                    <span class="text-muted small">@L["TotalQuantity"]</span>
                    <strong class="ms-1 text-primary">@_currentBatch.TotalQuantity.ToString("N3")</strong>
                </div>
                <div class="col-sm-3">
                    <span class="text-muted small">@L["TotalValue"]</span>
                    <strong class="ms-1 text-success">@_currentBatch.TotalValue.ToString("N2")</strong>
                </div>
                <div class="col-sm-3">
                    <span class="text-muted small">@L["ImportedAt"]</span>
                    <strong class="ms-1">@L["UtcTime", _currentBatch.ImportedAtUtc]</strong>
                </div>
            </div>
        </div>

        <div class="table-responsive" style="max-height: 520px;">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light sticky-top">
                    <tr>
                        <th>@L["Row"]</th>
                        @foreach (StockReportFieldMetadata metadata in StockReportFieldCatalog.All)
                        {
                            <th class="text-nowrap @(IsNumeric(metadata) ? "text-end" : null)" title="@metadata.GetAlternateName()">@metadata.GetLocalizedName()</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (StockReportItem item in filteredItems)
                    {
                        <tr>
                            <td class="text-muted small">@item.SourceRowNumber</td>
                            @foreach (StockReportFieldMetadata metadata in StockReportFieldCatalog.All)
                            {
                                <td class="text-nowrap @(IsNumeric(metadata) ? "text-end font-monospace" : null)">@FormatValue(item, metadata.Field)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private const long MaxUploadFileSizeBytes = 25 * 1024 * 1024;
    private const string LocalStorageKey = "scp.stockReport.lastColumnMapping.v2";

    private byte[]? _fileBytes;
    private string? _uploadedFileName;
    private string? _selectedSheetName;
    private int _headerRowNumber = 1;
    private int _dataStartRowNumber = 2;
    private bool _isBusy;
    private string? _statusMessage;
    private bool _isErrorStatus;
    private string _searchQuery = string.Empty;

    private StockReportInspectionDto? _inspection;
    private Dictionary<StockReportField, int> _fieldColumnMap = new();
    private StockReportImportResultDto? _lastImportResult;
    private StockReportBatch? _currentBatch;

    protected override async Task OnInitializedAsync()
    {
        _currentBatch = await StockReportRepository.GetCurrentAsync();
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs args)
    {
        _isBusy = true;
        _statusMessage = null;
        _isErrorStatus = false;

        try
        {
            IBrowserFile file = args.File;
            await using Stream stream = file.OpenReadStream(MaxUploadFileSizeBytes);
            using MemoryStream ms = new();
            await stream.CopyToAsync(ms);

            _fileBytes = ms.ToArray();
            _uploadedFileName = file.Name;
            _selectedSheetName = null;

            InspectCurrentBytes();
            _statusMessage = L["StatusInspected", _uploadedFileName, _inspection?.Columns.Count ?? 0];
        }
        catch (Exception ex)
        {
            _isErrorStatus = true;
            _statusMessage = L["StatusReadFailed", ex.Message];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private Task OnSheetChangedAsync(ChangeEventArgs args)
    {
        _selectedSheetName = args.Value?.ToString();
        InspectCurrentBytes();
        return Task.CompletedTask;
    }

    private void OnHeaderRowChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out int parsed) && parsed >= 1)
        {
            _headerRowNumber = parsed;
            if (_dataStartRowNumber <= _headerRowNumber)
            {
                _dataStartRowNumber = _headerRowNumber + 1;
            }
        }
    }

    private Task ReinspectCurrentFileAsync()
    {
        InspectCurrentBytes();
        return Task.CompletedTask;
    }

    private void InspectCurrentBytes()
    {
        if (_fileBytes is null || string.IsNullOrWhiteSpace(_uploadedFileName))
        {
            return;
        }

        try
        {
            using MemoryStream ms = new(_fileBytes);
            _inspection = ExcelInspector.Inspect(
                ms,
                _uploadedFileName,
                _selectedSheetName,
                _headerRowNumber,
                _dataStartRowNumber);

            _selectedSheetName = _inspection.ActiveSheetName;
            _headerRowNumber = _inspection.HeaderRowNumber;
            _dataStartRowNumber = _inspection.DataStartRowNumber;
            ApplyAutoSuggestedMapping();
        }
        catch (Exception ex)
        {
            _isErrorStatus = true;
            _statusMessage = L["StatusInspectionFailed", ex.Message];
        }
    }

    private void ApplyAutoSuggestedMapping()
    {
        _fieldColumnMap.Clear();
        if (_inspection is null)
        {
            return;
        }

        foreach (KeyValuePair<StockReportField, int> pair in _inspection.SuggestedMapping)
        {
            _fieldColumnMap[pair.Key] = pair.Value;
        }
    }

    private int GetSelectedColumn(StockReportField field)
    {
        return _fieldColumnMap.TryGetValue(field, out int colIndex) ? colIndex : 0;
    }

    private void OnFieldColumnChanged(StockReportField field, string? rawValue)
    {
        if (int.TryParse(rawValue, out int colIndex) && colIndex > 0)
        {
            _fieldColumnMap[field] = colIndex;
        }
        else
        {
            _fieldColumnMap.Remove(field);
        }
    }

    private int GetMappedColumnCount()
    {
        return _fieldColumnMap.Values.Where(v => v > 0).Distinct().Count();
    }

    private IReadOnlyList<DetectedExcelColumnDto> GetIgnoredColumns()
    {
        if (_inspection is null)
        {
            return [];
        }

        HashSet<int> mapped = _fieldColumnMap.Values.Where(v => v > 0).ToHashSet();
        return _inspection.Columns.Where(c => !mapped.Contains(c.ColumnIndex)).ToList();
    }

    private StockReportField? GetFieldForColumn(int columnIndex)
    {
        foreach (KeyValuePair<StockReportField, int> pair in _fieldColumnMap)
        {
            if (pair.Value == columnIndex)
            {
                return pair.Key;
            }
        }

        return null;
    }

    private bool AreRequiredFieldsMapped()
    {
        foreach (StockReportFieldMetadata metadata in StockReportFieldCatalog.Required)
        {
            if (!_fieldColumnMap.TryGetValue(metadata.Field, out int colIndex) || colIndex <= 0)
            {
                return false;
            }
        }

        return true;
    }

    private async Task ExecuteImportAsync()
    {
        if (_fileBytes is null || string.IsNullOrWhiteSpace(_uploadedFileName))
        {
            return;
        }

        _isBusy = true;
        _isErrorStatus = false;
        _statusMessage = null;

        try
        {
            StockReportColumnMappingDto mapping = new()
            {
                SheetName = _selectedSheetName,
                HeaderRowNumber = _headerRowNumber,
                DataStartRowNumber = Math.Max(_headerRowNumber + 1, _dataStartRowNumber),
                FieldColumnMap = new Dictionary<StockReportField, int>(_fieldColumnMap)
            };

            using MemoryStream ms = new(_fileBytes);
            _lastImportResult = ExcelParser.Parse(ms, _uploadedFileName, mapping);

            StockReportBatch batch = _lastImportResult.ToBatch();

            await StockReportRepository.SaveCurrentAsync(batch);
            _currentBatch = batch;

            _statusMessage = L[
                "StatusImported",
                _lastImportResult.ValidRowCount,
                _lastImportResult.SourceFileName,
                _lastImportResult.IgnoredColumnIndices.Count,
                _lastImportResult.ErrorRowCount];
        }
        catch (Exception ex)
        {
            _isErrorStatus = true;
            _statusMessage = L["StatusImportFailed", ex.Message];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SaveMappingToStorageAsync()
    {
        try
        {
            StockReportColumnMappingDto dto = new()
            {
                SheetName = _selectedSheetName,
                HeaderRowNumber = _headerRowNumber,
                DataStartRowNumber = _dataStartRowNumber,
                FieldColumnMap = new Dictionary<StockReportField, int>(_fieldColumnMap)
            };

            string json = JsonSerializer.Serialize(dto);
            await JsRuntime.InvokeVoidAsync("localStorage.setItem", LocalStorageKey, json);
            _isErrorStatus = false;
            _statusMessage = L["StatusMappingSaved"];
        }
        catch (Exception ex)
        {
            _isErrorStatus = true;
            _statusMessage = L["StatusMappingSaveFailed", ex.Message];
        }
    }

    private async Task LoadSavedMappingFromStorageAsync()
    {
        try
        {
            string? json = await JsRuntime.InvokeAsync<string?>("localStorage.getItem", LocalStorageKey);
            if (string.IsNullOrWhiteSpace(json))
            {
                _isErrorStatus = true;
                _statusMessage = L["StatusNoSavedMapping"];
                return;
            }

            StockReportColumnMappingDto? dto = JsonSerializer.Deserialize<StockReportColumnMappingDto>(json);
            if (dto is null)
            {
                _isErrorStatus = true;
                _statusMessage = L["StatusSavedMappingInvalid"];
                return;
            }

            _headerRowNumber = Math.Max(1, dto.HeaderRowNumber);
            _dataStartRowNumber = Math.Max(_headerRowNumber + 1, dto.DataStartRowNumber);
            _fieldColumnMap = new Dictionary<StockReportField, int>(dto.FieldColumnMap);
            _isErrorStatus = false;
            _statusMessage = L["StatusMappingLoaded"];
        }
        catch (Exception ex)
        {
            _isErrorStatus = true;
            _statusMessage = L["StatusMappingLoadFailed", ex.Message];
        }
    }

    private async Task ClearStoredReportAsync()
    {
        await StockReportRepository.ClearAsync();
        _currentBatch = null;
        _lastImportResult = null;
        _isErrorStatus = false;
        _statusMessage = L["StatusReportCleared"];
    }

    private string LocalizeRowError(StockReportRowErrorDto error)
    {
        string fieldName = StockReportFieldLocalization.GetLocalizedFieldName(error.Field);
        if (string.IsNullOrWhiteSpace(error.RawValue))
        {
            return L["RowErrorRequired", fieldName];
        }

        if (StockReportFieldCatalog.TryParseFieldKey(error.Field, out StockReportField field))
        {
            StockReportFieldMetadata metadata = StockReportFieldCatalog.GetMetadata(field);
            if (metadata.MaxLength is int maxLength && error.RawValue.Length > maxLength)
            {
                return L["RowErrorTooLong", fieldName, maxLength];
            }

            LocalizedString message = L[$"RowErrorInvalid_{metadata.DataType}", fieldName, error.RawValue];
            if (!message.ResourceNotFound)
            {
                return message;
            }
        }

        return L["RowErrorInvalid", fieldName, error.RawValue];
    }

    private IReadOnlyList<StockReportItem> GetFilteredItems()
    {
        if (_currentBatch is null)
        {
            return [];
        }

        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            return _currentBatch.Items;
        }

        string q = _searchQuery.Trim();
        return _currentBatch.Items
            .Where(item =>
                item.MaterialDocumentNumber.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                item.MaterialDocumentItem.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                item.MaterialNumber.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                item.MaterialDescription.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                item.MaterialDocumentYear.ToString().Contains(q, StringComparison.OrdinalIgnoreCase) ||
                Contains(item.WbsElement, q) ||
                Contains(item.BatchNumber, q) ||
                Contains(item.PurchaseOrder, q) ||
                Contains(item.VendorName, q))
            .ToList();
    }

    private static bool Contains(string? value, string query)
    {
        return value?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;
    }

    private static bool IsNumeric(StockReportFieldMetadata metadata)
    {
        return metadata.DataType == StockReportFieldType.Decimal;
    }

    private static string FormatValue(StockReportItem item, StockReportField field)
    {
        return item.GetValue(field) switch
        {
            null => string.Empty,
            decimal value when field == StockReportField.TotalStockValue => value.ToString("N2"),
            decimal value => value.ToString("N3"),
            DateOnly date => date.ToString("d", CultureInfo.CurrentCulture),
            bool flag => flag ? "X" : string.Empty,
            object value => value.ToString() ?? string.Empty
        };
    }
}
