@inject IStringLocalizer<StockReportResources> L

<div class="modal d-block"
     tabindex="-1"
     role="dialog"
     aria-modal="true"
     aria-labelledby="clearReportDialogTitle"
     aria-describedby="clearReportDialogMessage"
     @onclick="CloseAsync"
     @onkeydown="OnKeyDownAsync">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title h5" id="clearReportDialogTitle">
                    @L["ClearReportDialogTitle"]
                </h2>
                <button type="button"
                        class="btn-close"
                        aria-label="@L["Close"]"
                        @onclick="CloseAsync"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0" id="clearReportDialogMessage">
                    @L["ClearReportDialogMessage", FileName, RowCount]
                </p>
            </div>
            <div class="modal-footer">
                <button @ref="_cancelButton"
                        type="button"
                        class="btn btn-outline-secondary"
                        @onclick="CloseAsync">
                    @L["Cancel"]
                </button>
                <button type="button"
                        class="btn btn-danger"
                        disabled="@_isClearing"
                        @onclick="ConfirmAsync">
                    @L["ClearReportConfirm"]
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop show"></div>

@code {
    private ElementReference _cancelButton;
    private bool _isClearing;

    [Parameter, EditorRequired]
    public string FileName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public int RowCount { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _cancelButton.FocusAsync();
        }
    }

    private async Task ConfirmAsync()
    {
        _isClearing = true;
        try
        {
            await OnConfirm.InvokeAsync();
        }
        finally
        {
            _isClearing = false;
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private async Task CloseAsync()
    {
        if (_isClearing)
        {
            return;
        }

        await OnClose.InvokeAsync();
    }
}
